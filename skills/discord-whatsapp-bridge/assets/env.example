# Copy to scripts/bridge/.env and fill in real values.
# .env files must NEVER be committed (this is a public repository).

# Discord bot token from https://discord.com/developers/applications
# The bot needs the Message Content privileged intent enabled.
DISCORD_BOT_TOKEN=your_discord_bot_token

# Destination WhatsApp number: digits only, country code + number, no '+'.
# Example for US +1 555 123 4567:
WHATSAPP_TARGET_NUMBER=15551234567

# Optional: path to the channel-mapping config JSON.
# Defaults to ../../assets/bridge_config.example.json relative to index.js.
# BRIDGE_CONFIG_PATH=/path/to/bridge_config.json
